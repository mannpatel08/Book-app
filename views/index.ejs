<%- include('partials/header') %>

<section class="hero">
    <h1>Manage Your <span style="color: var(--primary);">Collection</span></h1>
    <p>Efficiently track, update, and manage your bookstore inventory.</p>
    
    <div class="stats-grid">
        <div class="stat-card">
            <h3><%= totalBooks %></h3>
            <p>Total Books</p>
        </div>
        <div class="stat-card">
            <h3><%= books.reduce((acc, book) => acc + book.quantity, 0) %></h3>
            <p>Total Inventory</p>
        </div>
    </div>
</section>

<div class="container">
    <div class="book-grid">
        <% if (books.length > 0) { %>
            <% books.forEach(book => { %>
                <div class="book-card">
                    <img src="/uploads/<%= book.image %>" alt="<%= book.title %>" class="book-img">
                    <div class="book-info">
                        <span class="category-tag"><%= book.category %></span>
                        <h2 class="book-title"><%= book.title %></h2>
                        <p class="book-author">by <%= book.author %></p>
                        <p class="book-price">₹<%= book.price %></p>
                        
                        <div class="book-meta">
                            <span class="quantity"><i class="fas fa-boxes"></i> <%= book.quantity %> in stock</span>
                            <div class="actions">
                                <a href="/edit/<%= book._id %>" class="btn-icon btn-edit" title="Edit"><i class="fas fa-edit"></i></a>
                                <a href="/delete/<%= book._id %>" class="btn-icon btn-delete" title="Delete" onclick="return confirm('Are you sure you want to delete this book?')"><i class="fas fa-trash"></i></a>
                            </div>
                        </div>
                    </div>
                </div>
            <% }) %>
        <% } else { %>
            <div style="grid-column: 1/-1; text-align: center; padding: 4rem;">
                <p style="color: var(--text-muted); font-size: 1.2rem;">No books found in the database. <a href="/add" style="color: var(--primary);">Add your first book!</a></p>
            </div>
        <% } %>
    </div>
</div>

<%- include('partials/footer') %>
